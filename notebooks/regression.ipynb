    }
   ],
   "source": [
    "\n",
    "top2 = results_df.head(2)[\"Model\"].tolist()\n",
    "\n",
    "rf_pipeline = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"model\", RandomForestRegressor(\n",
    "        n_estimators=200,\n",
    "        random_state=42,\n",
    "        n_jobs=-1\n",
    "    ))\n",
    "])\n",
    "\n",
    "poly_pipeline = Pipeline([\n",
    "    (\"preprocessor\", preprocessor),\n",
    "    (\"poly\", PolynomialFeatures(degree=2, include_bias=False)),\n",
    "    (\"model\", LinearRegression())\n",
    "])\n",
    "\n",
    "cv_estimators = {\n",
    "    \"Random Forest\": rf_pipeline,\n",
    "    \"Polynomial (deg 2)\": poly_pipeline\n",
    "}\n",
    "\n",
    "cv_results = []\n",
    "\n",
    "for name in top2:\n",
    "    scores = cross_val_score(\n",
    "        cv_estimators[name],\n",
    "        X_train,\n",
    "        y_train,\n",
    "        cv=5,\n",
    "        scoring=\"r2\",\n",
    "        n_jobs=-1\n",
    "    )\n",
    "\n",
    "    cv_results.append({\n",
    "        \"Model\": name,\n",
    "        \"Mean CV R²\": scores.mean(),\n",
    "        \"Std CV R²\": scores.std()\n",
    "    })\n",
    "\n",
    "pd.DataFrame(cv_results).round(4)"
   ]
  },
