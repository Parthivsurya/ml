    "## Hyperparameter Tuning\n",
    "\n",
    "Quick GridSearch on the two regularised linear models (Ridge and Lasso) to see\n",
    "if a better `alpha` helps."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "506d695b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Best Ridge alpha: 0.1  CV R²: 0.8333\n",
      "Best Lasso alpha: 0.1  CV R²: 0.8333\n"
     ]
    }
   ],
   "source": [
    "param_ridge = {\"alpha\": [0.1, 1.0, 10.0, 100.0, 1000.0]}\n",
    "gs_ridge = GridSearchCV(Ridge(), param_ridge, cv=5, scoring=\"r2\", n_jobs=-1)\n",
    "gs_ridge.fit(X_train_proc, y_train)\n",
    "ridge_tuned_pred = gs_ridge.best_estimator_.predict(X_test_proc)\n",
    "print(\"Best Ridge alpha:\", gs_ridge.best_params_[\"alpha\"], \" CV R²:\", round(gs_ridge.best_score_, 4))\n",
    "\n",
    "param_lasso = {\"alpha\": [0.01, 0.1, 1.0, 10.0]}\n",
    "gs_lasso = GridSearchCV(Lasso(max_iter=50000), param_lasso, cv=5, scoring=\"r2\", n_jobs=-1)\n",
    "gs_lasso.fit(X_train_proc, y_train)\n",
    "lasso_tuned_pred = gs_lasso.best_estimator_.predict(X_test_proc)\n",
    "print(\"Best Lasso alpha:\", gs_lasso.best_params_[\"alpha\"], \" CV R²:\", round(gs_lasso.best_score_, 4))"
